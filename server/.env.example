# ==============================================================================
# SEIMS Server Environment Variables Template
# Copy this file to .env and replace the values with your local configuration.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seims_db?schema=public"

# JSON Web Token (JWT) Configuration
JWT_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-token-key-change-in-production"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Client Application URL (for CORS)
CLIENT_URL="http://localhost:3000"
