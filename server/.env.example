# ==============================================================================
# SEIMS Server Environment Variables Template
# Copy this file to .env and replace the values with your local configuration.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seims_db?schema=public"

# Better Auth Configuration
# Secret key for encrypting sessions and tokens (minimum 32 characters)
BETTER_AUTH_SECRET="your-super-secret-better-auth-key-min-32-chars-long"
BETTER_AUTH_URL="http://localhost:5000"

# Client Application URL (for CORS and redirects)
CLIENT_URL="http://localhost:3000"
